# Copy to backend/.env and fill in. Never commit .env.

# --- Monad / chain data -----------------------------------------------------
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Private Alchemy endpoint; takes precedence over MONAD_RPC_URL
ALCHEMY_RPC_URL=
# auto = Envio (if configured) -> Monad RPC ; also: envio | rpc | demo | none
MONAD_CHAIN_ID=10143
DATA_SOURCE=auto
RPC_SCAN_BLOCKS=150
CHAIN_TIMEOUT_SECONDS=8
# Envio Monad Testnet: https://monad-testnet.hypersync.xyz
# Mainnet: https://monad.hypersync.xyz (set MONAD_CHAIN_ID=143 consistently)
ENVIO_HYPERSYNC_URL=
ENVIO_API_TOKEN=

# --- Storage / config -------------------------------------------------------
DATABASE_URL=sqlite:///./aegis.db
# Defaults to "services + tests + scripts + config/config/risk.yaml" when unset
RISK_CONFIG_PATH=

# --- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# generate_content = default REST-compatible path; interactions = optional alternate
GEMINI_API=generate_content
# auto = real Gemini when key set ; mock = deterministic triage (recorded demo) ; off = force fallback
GEMINI_MODE=auto
GEMINI_TIMEOUT_SECONDS=12
# Low reasoning effort keeps bounded classification within the request deadline.
# Use default to omit this option for models that do not support thinking levels.
GEMINI_THINKING_LEVEL=low
GEMINI_TRIGGER_SCORE=0.35
GEMINI_MAX_OUTPUT_TOKENS=2048

# --- On-chain evidence (AegisRegistry) -------------------------------------
AEGIS_REGISTRY_ADDRESS=
# Risk-oracle signer for updateRisk(). PoC only - production needs proper signing/attestation.
ORACLE_PRIVATE_KEY=

# --- API / security (see SECURITY.md) ---------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AEGIS_ADMIN_KEY=
AEGIS_EMPLOYEE_KEYS=
TOKEN_SECRET=
# Defaults: true in production, false in development
REQUIRE_WALLET_SIGNATURE=
ENABLE_DEMO=
RATE_LIMIT_PER_MINUTE=30
TRUST_PROXY_HEADERS=false
ALLOWED_HOSTS=
MAX_BODY_BYTES=32768
